{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "Artillery engineering comes to Create\n\nAttributions:\nLogo by Milkyfur\nTextures by rbasamoyai, Milkyfur, and LopyLuna\n\nUnofficial Fabric 26.1.2 port on Create Fly.",
  "authors": [
    "${mod_author}"
  ],
  "contact": {
    "sources": "${mod_sources}",
    "issues": "${mod_issues}"
  },
  "license": "${mod_license}",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "rbasamoyai.createbigcannons.fabric.CreateBigCannonsFabric"
    ],
    "client": [
      "rbasamoyai.createbigcannons.fabric.CBCClientFabric"
    ]
  },
  "accessWidener": "${mod_id}.accesswidener",
  "mixins": [
    "${mod_id}.mixins.json"
  ],
  "depends": {
    "minecraft": "${minecraft_version}",
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_api_version}",
    "forgeconfigapiport": ">=${forgeconfigapiport_version}",
    "create": "${create_fly_version_range}",
    "ritchiesprojectilelib": "*",
    "java": ">=25"
  },
  "custom": {
    "modmenu": {
      "parent": {
        "id": "create"
      }
    }
  }
}
